{
  "name": "Node Container System",
  "scopeName": "source.ncs",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#closer"
    },
    {
      "include": "#shortcloser"
    },
    {
      "include": "#modeOpen"
    },
    {
      "include": "#node"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#mode"
    },
    {
      "include": "#calls"
    },
    {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.ncs"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.triplequote.ncs",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": []
        },
        {
          "match": "!<--.*$",
          "name": "comment.line.exclamation.ncs"
        },
        {
          "match": "!\\{(?:\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?<![\\p{L}\\p{N}_])'(?:\\\\.|[^'\\\\\\r\\n])*'|[^}\\r\\n])*(?:\\}|(?=\\r?$))",
          "name": "comment.block.exclamation.ncs"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "match": "[()\\[\\]{}]",
          "name": "punctuation.bracket.ncs"
        },
        {
          "match": "[,|:=]",
          "name": "punctuation.separator.ncs"
        }
      ]
    },
    "operators": {
      "match": "[%&$?]",
      "name": "keyword.operator.modifier.ncs"
    },
    "types": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#operators"
        },
        {
          "match": "\\b(?:str|abc|[pn]?int\\d*|float\\d*|bool|binary|fstr|fint|list|dict|any|color|image|mimage|sound|vector|matrix|matrix3d|use|import|from|def|d|p|ip|loop|if|try|match)\\b",
          "name": "entity.name.type.signature.ncs"
        },
        {
          "include": "#brackets"
        },
        {
          "match": "\\d+",
          "name": "constant.numeric.ncs"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(?:in|range|break|continue|is|or|not|as|pass)\\b",
          "name": "keyword.control.flow.ncs"
        },
        {
          "match": "\\b(?:random\\.vonmisesvariate|random\\.binomialvariate|sys\\.file\\.write\\.binary|random\\.lognormvariate|random\\.weibullvariate|sys\\.file\\.read\\.binary|random\\.normalvariate|random\\.paretovariate|sys\\.compiler\\.report|random\\.gammavariate|sys\\.random\\.uniform|random\\.getrandbits|random\\.expovariate|random\\.betavariate|__str__\\.identifier|__str__\\.alphabetic|__str__\\.is_integer|sys\\.time\\.datetime|sys\\.random\\.random|random\\.triangular|sys\\.random\\.range|random\\.randbytes|__str__\\.contains|__str__\\.is_float|random\\.getstate|random\\.setstate|__str__\\.between|__str__\\.unquote|sys\\.file\\.write|sys\\.time\\.clock|sys\\.random\\.int|random\\.uniform|random\\.shuffle|random\\.choices|__str__\\.length|__str__\\.starts|__str__\\.before|__str__\\.cquote|str\\.identifier|str\\.alphabetic|str\\.is_integer|sys\\.file\\.read|sys\\.time\\.date|random\\.random|random\\.choice|random\\.sample|binary\\.length|__str__\\.slice|__str__\\.lines|__str__\\.after|sys\\.time\\.day|random\\.range|random\\.gauss|binary\\.slice|__str__\\.char|__str__\\.find|__str__\\.trim|__str__\\.ends|str\\.contains|str\\.is_float|math\\.lshift|math\\.rshift|random\\.seed|list\\.length|__str__\\.len|__str__\\.get|str\\.between|str\\.unquote|sys\\.encode|random\\.int|binary\\.len|binary\\.get|list\\.rfind|str\\.length|str\\.starts|str\\.before|str\\.cquote|list\\.find|str\\.slice|str\\.lines|str\\.after|continue|math\\.and|math\\.xor|math\\.not|sys\\.time|list\\.len|list\\.get|str\\.char|str\\.find|str\\.trim|str\\.ends|math\\.or|sys\\.env|str\\.len|str\\.get|return|print|input|break|range|exit|pass|math|sys\\.file)(?=\\s*\\(|\\?exists\\s*\\()",
          "name": "support.function.builtin.ncs"
        },
        {
          "match": "(?<=\\?)exists(?=\\s*\\()",
          "name": "support.function.builtin.ncs"
        }
      ]
    },
    "calls": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*\\()",
      "name": "entity.name.function.call.ncs"
    },
    "numbers": {
      "match": "(?<![A-Za-z_])[-+]?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?(?![A-Za-z_])",
      "name": "constant.numeric.ncs"
    },
    "variables": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\b",
      "name": "variable.other.node.ncs"
    },
    "mode": {
      "match": "\\b(?:import|from|use|def|match|case|if|elif|else|while|for|in|with|try|throw|catch|return|exit|break|continue|pass)\\b",
      "name": "keyword.control.mode.ncs"
    },
    "interpolation": {
      "name": "meta.interpolation.ncs",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#brackets"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\b",
          "name": "variable.parameter.interpolation.ncs"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.bracket.ncs"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.ncs"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.ncs",
          "begin": "\\bf\"",
          "end": "(?<!\\\\)\"",
          "patterns": [
            {
              "match": "\\{\\{|\\}\\}",
              "name": "punctuation.bracket.ncs"
            },
            {
              "include": "#interpolation"
            },
            {
              "match": "\\\\.",
              "name": "constant.character.escape.ncs"
            }
          ]
        },
        {
          "name": "string.quoted.double.ncs",
          "begin": "\"",
          "end": "(?<!\\\\)\"",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.ncs"
            }
          ]
        },
        {
          "name": "string.quoted.single.ncs",
          "begin": "'",
          "end": "(?<!\\\\)'",
          "patterns": []
        }
      ]
    },
    "paramTypes": {
      "name": "meta.parameter.type.ncs",
      "begin": ":",
      "end": "(?=\\s*(?:!\\{|,|\\||\\)>))",
      "patterns": [
        {
          "name": "meta.type.alternatives.ncs",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#types"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.ncs"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.ncs"
            }
          }
        },
        {
          "include": "#types"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.ncs"
        }
      }
    },
    "definition": {
      "name": "meta.definition.ncs",
      "begin": "(<)(def)(:)([A-Za-z_][A-Za-z0-9_]*)(\\()",
      "end": "(\\))(>)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#paramTypes"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "#variables"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.ncs"
        },
        "2": {
          "name": "keyword.control.mode.ncs"
        },
        "3": {
          "name": "punctuation.definition.tag.ncs"
        },
        "4": {
          "name": "entity.name.function.definition.ncs"
        },
        "5": {
          "name": "punctuation.bracket.ncs"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.bracket.ncs"
        },
        "2": {
          "name": "punctuation.definition.tag.ncs"
        }
      }
    },
    "closer": {
      "name": "meta.closer.ncs",
      "begin": "</",
      "end": ">",
      "patterns": [
        {
          "include": "#types"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "invalid.illegal.signature.ncs"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.ncs"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.ncs"
        }
      }
    },
    "shortcloser": {
      "match": "(/)(?:(\\d+)(\\|))?(p|ip|try|match|use|import|from)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.ncs"
        },
        "2": {
          "name": "constant.numeric.ncs"
        },
        "3": {
          "name": "punctuation.definition.tag.ncs"
        },
        "4": {
          "name": "entity.name.type.signature.ncs"
        },
        "5": {
          "name": "punctuation.definition.tag.ncs"
        }
      }
    },
    "node": {
      "match": "(<)([A-Za-z_][A-Za-z0-9_]*)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.ncs"
        },
        "2": {
          "name": "entity.name.tag.node.ncs"
        },
        "3": {
          "name": "punctuation.definition.tag.ncs"
        }
      }
    },
    "modeOpen": {
      "match": "(<)(import|from|use|if|elif|else|while|for|with|match|try|throw|catch)(?=[|:(>])",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.ncs"
        },
        "2": {
          "name": "keyword.control.mode.ncs"
        }
      }
    },
    "punctuation": {
      "match": "</?|/|>",
      "name": "punctuation.definition.tag.ncs"
    }
  }
}
