{
  "Node string": {
    "prefix": "node-str",
    "body": [
      "<${1:name}>\"${2:text}\"</str>"
    ],
    "description": "Named NCS string node"
  },
  "Node abc": {
    "prefix": "node-abc",
    "body": [
      "<${1:name}>${2:letters}</abc>"
    ],
    "description": "Alphabetic node"
  },
  "Node integer": {
    "prefix": "node-int",
    "body": [
      "<${1:number}>${2:0}</int>"
    ]
  },
  "Node float": {
    "prefix": "node-float",
    "body": [
      "<${1:number}>${2:0.0}</float>"
    ]
  },
  "Forced signature": {
    "prefix": "force-node",
    "body": [
      "<${1:name}>${2:42}</\\$${3:int}>"
    ],
    "description": "Forced immutable signature; $ escaped for VS Code snippets"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "<print(${1:message})/p>"
    ]
  },
  "Print f-string": {
    "prefix": "printf",
    "body": [
      "<",
      "p",
      "r",
      "i",
      "n",
      "t",
      "(",
      "f",
      "\"",
      "$",
      "{",
      "1",
      ":",
      "H",
      "e",
      "l",
      "l",
      "o",
      "}",
      ",",
      " ",
      "{",
      "$",
      "{",
      "2",
      ":",
      "n",
      "a",
      "m",
      "e",
      "}",
      "}",
      "\"",
      ")",
      "/",
      "p",
      ">",
      "$",
      "0"
    ]
  },
  "Function": {
    "prefix": "def",
    "body": [
      "<def:${1:function_name}(${2:arg})>",
      "    ${3:pass}",
      "</d>"
    ]
  },
  "If": {
    "prefix": "if",
    "body": [
      "<if|${1:true}>",
      "    ${2:pass}",
      "</if>"
    ]
  },
  "For": {
    "prefix": "for",
    "body": [
      "<for|${1:item}|in|${2:range(0|10)}>",
      "    ${3:pass}",
      "</loop>"
    ]
  },
  "While": {
    "prefix": "while",
    "body": [
      "<while|${1:true}>",
      "    ${2:pass}",
      "</loop>"
    ]
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "<try:",
      "    |${1:<throw(warn): |'Warning.'|/try>}|",
      "    |<catch(warn): |${2:<print(\"Caught\")/p>}|/try>|",
      "/try>"
    ]
  },
  "Dictionary": {
    "prefix": "dict",
    "body": [
      "<${1:Dictionary}>",
      "    <${2:Apple}>\"${3:Value}\"</str>",
      "</dict[str](1)>"
    ]
  },
  "List": {
    "prefix": "list",
    "body": [
      "<${1:items}>[${2:1|2|3}]</list[${3:int}](3)>"
    ]
  },
  "File read binary": {
    "prefix": "readbin",
    "body": [
      "<${1:source}>sys.file.read.binary(\"${2:file.ncs}\")</binary>"
    ]
  },
  "Exit no message": {
    "prefix": "exit0",
    "body": [
      "exit()"
    ]
  },
  "Exit with message": {
    "prefix": "exit1",
    "body": [
      "exit(\"${1:Finished}\")"
    ]
  },
  "Documented function": {
    "prefix": "defdoc",
    "body": [
      "<def:${1:name}(${2:value}:${3:str}!{${4:Parameter description}\\})> !<-- ${5:Short summary}",
      "\"\"\"",
      "${6:Markdown description}",
      "\"\"\"",
      "\t${7:pass}",
      "</d>$0"
    ]
  },
  "Basic unsigned node": {
    "prefix": "node",
    "body": [
      "<",
      "$",
      "{",
      "1",
      ":",
      "m",
      "o",
      "d",
      "e",
      "}",
      ">",
      "\"",
      "$",
      "{",
      "2",
      ":",
      "d",
      "a",
      "t",
      "a",
      "}",
      "\"",
      "<",
      "/",
      ">",
      "$",
      "0"
    ],
    "description": "Basic named node. Choose its signature manually."
  },
  "Elif branch": {
    "prefix": "elif",
    "body": [
      "<elif|${1:true}>",
      "\t${2:pass}",
      "$0"
    ],
    "description": "Add an elif branch"
  },
  "Match case": {
    "prefix": "case",
    "body": [
      "|case|(${1:\"example\"}):",
      "\t${2:pass}",
      "$0"
    ],
    "description": "Add a matching case"
  },
  "Default case": {
    "prefix": "case_default",
    "body": [
      "|case|_:",
      "\t${1:pass}",
      "$0"
    ],
    "description": "Add default case"
  }
}
